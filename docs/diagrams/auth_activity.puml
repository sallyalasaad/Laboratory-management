@startuml
title مخطط نشاط: المصادقة

start
:إرسال بيانات الدخول;
if (بيانات صحيحة؟) then (نعم)
  :إرجاع Token;
else (لا)
  :إرجاع رسالة خطأ (401/422);
endif

:طلب "نسيت كلمة المرور";
:التحقق من البريد;
if (البريد صالح؟) then (نعم)
  :إرسال OTP;
else (لا)
  :رفض الطلب (422);
endif

:إرسال OTP + كلمة مرور جديدة;
if (OTP صحيح؟) then (نعم)
  if (كلمة المرور مطابقة؟) then (نعم)
    :تحديث كلمة المرور;
  else (لا)
    :رفض (422 كلمة المرور غير متطابقة);
  endif
else (لا)
  :رفض (422 OTP غير صحيح);
endif

stop
@enduml
