@startuml
title مخطط نشاط: الإنتاج

start
:Admin ينشئ أمر إنتاج;
if (بيانات صحيحة؟) then (نعم)
  :إنشاء المراحل (تحضير/طبخ/تعبئة/تبريد/إنهاء);
else (لا)
  :رفض (422 تحقق من البيانات);
  stop
endif

:موظف الإنتاج يبدأ الأمر;
if (الأمر موجود؟) then (نعم)
  :تحديث الحالة In Progress;
else (لا)
  :رفض (404 الأمر غير موجود);
  stop
endif

:إكمال مرحلة نشطة;
if (يوجد مرحلة نشطة؟) then (نعم)
  :تحديث المرحلة Done;
  if (توجد مراحل Pending؟) then (نعم)
    :تفعيل المرحلة التالية;
  else (لا)
    :إنهاء الأمر (Completed);
  endif
else (لا)
  :رفض (لا توجد مرحلة نشطة);
endif

:إيقاف مؤقت;
if (الأمر موجود؟) then (نعم)
  :تحديث الحالة Paused;
else (لا)
  :رفض (404);
endif

:استئناف;
if (الأمر موجود؟) then (نعم)
  :تحديث الحالة In Progress;
else (لا)
  :رفض (404);
endif

:إنشاء Batch للمنتج النهائي;
if (البيانات صحيحة؟) then (نعم)
  :حفظ Batch;
else (لا)
  :رفض (422);
endif

stop
@enduml
