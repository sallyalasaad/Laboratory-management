@startuml
title مخطط نشاط: المواد الخام (المخزن)

start
:Admin ينشئ مهمة استلام;
if (بيانات صحيحة؟) then (نعم)
  :إنشاء مهمة Pending;
else (لا)
  :رفض (422 تحقق من البيانات);
  stop
endif

:أمين المخزن يرسل إدخال الاستلام;
if (المدخلات صحيحة؟) then (نعم)
  :تخزين pending_received_items;
else (لا)
  :رفض (422 مدخلات غير صحيحة);
  stop
endif

:تأكيد الاستلام;
if (يوجد عناصر للاستلام؟) then (نعم)
  :إنشاء دفعات خام;
  :تحديث المخزون;
  :إكمال المهمة;
else (لا)
  :رفض (422 لا توجد عناصر);
endif

:Admin ينشئ مهمة إرسال للإنتاج;
if (المخزون كافٍ؟) then (نعم)
  :إنشاء Production Order مؤقت;
  :تأكيد الإرسال (FIFO);
  if (التخصيص ناجح؟) then (نعم)
    :خصم المخزون وربط الدفعات بالأمر;
    :إكمال المهمة;
  else (لا)
    :فشل التخصيص (422);
  endif
else (لا)
  :رفض (422 مخزون غير كافٍ);
endif

stop
@enduml
